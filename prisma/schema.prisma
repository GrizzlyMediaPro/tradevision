// Prisma schema for TradeVision - MongoDB
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// —— Firme (prop trading) ——
model Firm {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String   @unique
  logo              String
  website           String?
  fundingUrl        String?
  description       String?
  payout            String?
  country           String?
  flag              String?
  trustScore        Float    @default(0)
  activeYears       Int      @default(0)
  maxAccounts       String?
  code              String?
  discount          String?
  platforms         String[]
  paymentMethods    String[]
  keyFeatures       Json     // [{ label, value, enabled }]
  challenges        Json     // Challenge[]
  payoutTimeline    Json     // PayoutStep[]
  rules             Json     // RuleTab[]
  excludedCountries String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// —— Deals carousel ——
model Deal {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firmSlug  String?
  logo      String
  name      String
  rating    Float    @default(0)
  discount  String
  code      String
  fundingUrl String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// —— Setări carousel (singleton) ——
model DealCarouselSettings {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  autoPlayEnabled  Boolean  @default(true)
  autoPlayInterval Int      @default(10000) // ms
  updatedAt        DateTime @updatedAt
}

// —— Capitole curs ——
model CourseChapter {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  videoId     String
  lessonLabel String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// —— Persoane înscrise la curs ——
model CourseEnrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  email     String
  phone     String
  createdAt DateTime @default(now())
}

// —— Link widget YouTube (singleton) ——
model LinkWidget {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  badge       String   @default("Live Trading")
  title       String
  description String?
  buttonText  String   @default("Watch Stream")
  thumbnail   String?
  youtubeUrl  String?
  updatedAt   DateTime @updatedAt
}

// —— Setari webinar (singleton) ——
model WebinarSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  webinarAt DateTime
  updatedAt DateTime @updatedAt
}

// —— Înscrieri formular webinar ——
model WebinarRegistration {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  email          String   @unique
  phone          String
  acceptedTerms  Boolean
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// —— Mesaje formular contact ——
model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// —— Abonați newsletter ——
model NewsletterSubscriber {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  source       String?
  subscribedAt DateTime @default(now())
}

// —— Prețuri cursuri plătite ——
model CourseProductPrice {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  slug          String   @unique
  priceAmount   Float
  priceCurrency String   @default("EUR")
  updatedAt     DateTime @updatedAt
}

// —— Coduri discount curs practic ——
model CourseDiscountCode {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  code      String    @unique
  type      String
  value     Float
  active    Boolean   @default(true)
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// —— Comenzi curs practic plătit ——
model PracticalCourseOrder {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  personType            String?
  billingData           Json?
  acceptedTerms         Boolean   @default(false)
  acceptedPrivacy       Boolean   @default(false)
  discountCode          String?
  discountType          String?
  discountValue         Float?
  discountAmountEur     Float?
  finalAmountEur        Float?
  finalAmountRon        Float?
  eurRonRate            Float?
  eurRonRateDate        String?
  eurRonRateSource      String?
  status                String    @default("draft")
  stripeSessionId       String?
  stripePaymentIntentId String?
  paidAt                DateTime?
  smartbillInvoiceSeries String?
  smartbillInvoiceNumber String?
  fulfillmentEmailSentAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// —— Firme partenere afișate pe pagina Payout Tracker ——
model TrackerPartnerLink {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// —— Snapshot-uri zilnice Payout Tracker ——
model PayoutTrackerSnapshot {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId  String
  snapshotDate String
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clerkUserId, snapshotDate])
  @@index([clerkUserId, snapshotDate(sort: Desc)])
}

// —— Curs privat (mentorat 1-on-1) ——
model PrivateCourse {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  description String?
  status      String   @default("published") // draft | published
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PrivateCourseChapter {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String   @db.ObjectId
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, order])
}

model PrivateCourseLesson {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  chapterId       String   @db.ObjectId
  courseId        String   @db.ObjectId
  title           String
  description     String?
  order           Int      @default(0)
  muxUploadId     String?
  muxAssetId      String?
  muxPlaybackId   String?
  durationSeconds Float?
  status          String   @default("pending") // pending | processing | ready | error
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([chapterId, order])
  @@index([courseId])
  @@index([muxUploadId])
  @@index([muxAssetId])
}

model CourseEntitlement {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId      String
  courseId         String    @db.ObjectId
  grantedByAdminId String
  grantedAt        DateTime  @default(now())
  revokedAt        DateTime?
  notes            String?

  @@unique([clerkUserId, courseId])
  @@index([courseId])
  @@index([clerkUserId])
}

model LessonProgress {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId    String
  lessonId       String   @db.ObjectId
  courseId       String   @db.ObjectId
  watchedSeconds Float    @default(0)
  completed      Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clerkUserId, lessonId])
  @@index([clerkUserId, courseId])
}
